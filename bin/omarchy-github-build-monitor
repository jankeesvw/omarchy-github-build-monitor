#!/usr/bin/env bash
#
# Builds on the default branch of one GitHub repository, as JSON.
#
# One push to main starts several workflows, and none of them on its own is
# "the build": the linter finishes in a minute while the deploy is still
# running, so a widget that follows a single workflow says green while the
# thing you actually care about is still going. So the unit here is the
# commit, not the run. Every workflow run started by a push to the branch is
# grouped by its head sha and rolled up: running if anything is still going,
# red if anything failed, and the duration is the wall clock from the first
# run starting to the last one finishing, which is what a person waiting on
# it experiences.
#
# All parsing and all arithmetic happens in jq. Nothing that came back from
# the API is ever evaluated by the shell: an "expires_in" that is really an
# array subscript is a command substitution inside $(( )), and this script
# takes numbers from a server it does not control.
#
# Authentication comes from the `gh` CLI, so no token is ever an argument of
# a process here. /proc/PID/cmdline is world readable.

set -uo pipefail

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy-github-build-monitor"
DEMO_FILE="$CACHE_DIR/demo"
DEFAULT_LIMIT=5

die() {
  printf '{"ok":false,"error":%s}\n' "$(printf '%s' "$1" | jq -Rs .)"
  exit 0
}

# A cache directory is private, and stays private. mkdir -p follows a symlink
# to a directory and reports success, and it leaves the mode of an existing
# directory alone, so neither of those is proof of anything on its own.
private_dir() {
  local dir="$1" owner
  mkdir -p -m 700 -- "$dir" 2>/dev/null
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  owner="$(stat -c '%u' -- "$dir" 2>/dev/null)" || return 1
  [[ "$owner" == "$(id -u)" ]] || return 1
  chmod 700 -- "$dir" 2>/dev/null || return 1

  # Unconditional, and about the contents rather than the directory: a
  # directory that is 700 today can hold files from a version that was not,
  # and anything in here that is neither a regular file nor a directory of
  # ours was never put there by this script. find uses lstat, so a planted
  # symlink is -type l whatever it points at, and goes.
  find "$dir" -mindepth 1 -maxdepth 1 ! -type f ! -type d -exec rm -rf -- {} + 2>/dev/null
  find "$dir" -mindepth 1 -maxdepth 1 -type f -exec chmod 600 -- {} + 2>/dev/null
  find "$dir" -mindepth 1 -maxdepth 1 -type d -exec chmod 700 -- {} + 2>/dev/null
  return 0
}

readable_file() { [ -f "$1" ] && [ ! -L "$1" ]; }

# rename(2) replaces the path, not what the path points at, so a symlink
# someone left on the destination cannot redirect the write.
write_private() {
  local dest="$1" tmp
  tmp="$(mktemp "$dest.XXXXXX" 2>/dev/null)" || return 1
  chmod 600 -- "$tmp" 2>/dev/null
  cat > "$tmp" || { rm -f -- "$tmp"; return 1; }
  mv -f -- "$tmp" "$dest" || { rm -f -- "$tmp"; return 1; }
}

valid_repo() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; }

# owner/name out of whatever identifies a GitHub repository: the browser URL,
# the clone URL, the ssh remote, or owner/name itself. This runs before
# valid_repo rather than instead of it, so the fence stays where it was: a
# URL on another host, or anything this does not recognise, comes out as a
# string that valid_repo then refuses.
normalize_repo() {
  local s="${1//[[:space:]]/}"
  case "$s" in
    git@github.com:*)     s="${s#git@github.com:}" ;;
    *://*|www.*|github.com/*)
      s="${s#*://}"
      s="${s#www.}"
      case "$s" in
        github.com/*) s="${s#github.com/}" ;;
        *) printf ''; return 0 ;;
      esac ;;
  esac
  s="${s%.git}"
  s="${s#/}"
  # Only the first two segments: a /tree/main or /pull/12 tail is still the
  # same repository.
  printf '%s' "$s" | awk -F/ 'NF>=2 && $1!="" && $2!="" {printf "%s/%s", $1, $2}'
}
valid_branch() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._/-]*$ ]]; }
valid_limit() { [[ "$1" =~ ^[0-9]{1,2}$ ]] && [ "$1" != "0" ]; }

demo_on() { readable_file "$DEMO_FILE"; }

# ------------------------------------------------------------------- cache
#
# Which files a commit touched never changes, so it is asked once and kept.
# Without that, flagging migrations would cost one API call per build on every
# poll; with it, only a commit nobody has seen before costs anything.
#
# The cache holds one file per project, named after it. A repository name has
# already been through valid_repo by the time it gets here, so the only thing
# left to deal with is the slash in the middle.
cache_file_for() { printf '%s/%s.json' "$CACHE_DIR" "${1//\//__}"; }

AVATAR_DIR="$CACHE_DIR/avatars"

valid_login() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9-]{0,38}$ ]]; }

# One small picture per author, fetched once and kept. Downloaded here rather
# than pointed at from QML: an Image with a remote source is the shell process
# opening a connection to a host named in data it was handed, which is the
# same door the rich-text problem opens. This way the only thing the panel
# ever loads is a local file this script put there.
#
# The URL is built from a login matched against GitHub's own shape, behind a
# literal prefix. The avatar_url the API sends is not used: it is a string
# from the network on its way to a fetch.
fetch_avatar() {
  local login="$1" dest tmp
  valid_login "$login" || return 1
  dest="$AVATAR_DIR/$login.png"
  readable_file "$dest" && return 0

  tmp="$(mktemp "$dest.XXXXXX" 2>/dev/null)" || return 1
  if curl -fsSL --max-time 8 --max-filesize 400000 \
          -o "$tmp" -- "https://github.com/$login.png?size=64" 2>/dev/null; then
    chmod 600 -- "$tmp" 2>/dev/null
    mv -f -- "$tmp" "$dest" || { rm -f -- "$tmp"; return 1; }
    return 0
  fi
  rm -f -- "$tmp"
  return 1
}

add_avatars() {
  local builds="$1" logins login found="{}"

  command -v curl >/dev/null 2>&1 || { printf '%s' "$builds"; return 0; }
  private_dir "$AVATAR_DIR" || { printf '%s' "$builds"; return 0; }

  logins="$(jq -r '.[].actor // empty | select(. != "")' <<<"$builds" 2>/dev/null | sort -u)"
  for login in $logins; do
    valid_login "$login" || continue
    fetch_avatar "$login" || continue
    found="$(jq -c --arg l "$login" --arg p "$AVATAR_DIR/$login.png" '.[$l] = $p' <<<"$found" 2>/dev/null)" \
      || found="$found"
  done

  jq -c --argjson a "$found" 'map(. + {avatar: (($a[.actor]) // "")})' <<<"$builds" 2>/dev/null \
    || printf '%s' "$builds"
}

# jq fails on invalid JSON and takes the whole run with it, not just the
# lookup that needed the file. One interrupted write would then break the
# widget until somebody deleted the file by hand, so a cache that does not
# read back as an object is simply started again: it is rebuildable by
# definition.
ensure_json_object() {
  local file="$1"
  readable_file "$file" && jq -e 'type == "object"' -- "$file" >/dev/null 2>&1 && return 0
  printf '{}\n' | write_private "$file"
}

# The paths in one commit that match any of the needles, as a JSON array.
# Plain substring matching on a lowercased path, never a regex: the needles
# are a setting, and a setting is not a place to accept a pattern that can be
# made to run for a very long time.
#
# A list rather than one word because the word people say and the word in the
# path are usually not the same one: Rails puts migrations in db/migrate, so
# looking for "migration" alone finds nothing at all in a Rails project.
commit_flagged_paths() {
  local repo="$1" sha="$2" needle="$3"
  gh_get "repos/$repo/commits/$sha" || return 1
  printf '%s' "$GH_OUT" \
    | jq -c --arg n "$needle" '
        ($n | ascii_downcase | split(",")
            | map(sub("^ +";"") | sub(" +$";""))
            | map(select(length > 0))) as $needles
        | [ .files[]?.filename // empty
            | . as $path
            | select($needles | any(. as $needle | ($path | ascii_downcase) | contains($needle))) ]
      ' 2>/dev/null
}

# builds JSON in, the same builds with a "flagged" array on each, out.
add_flagged_paths() {
  local repo="$1" needle="$2" builds="$3"
  local cache_path cache="{}" shas sha entry paths fresh="{}"

  [ -n "$needle" ] || { printf '%s' "$builds"; return 0; }

  if private_dir "$CACHE_DIR"; then
    cache_path="$(cache_file_for "$repo")"
    ensure_json_object "$cache_path"
    cache="$(cat -- "$cache_path" 2>/dev/null)"
    jq -e 'type == "object"' <<<"$cache" >/dev/null 2>&1 || cache="{}"
  fi

  shas="$(jq -r '.[].sha' <<<"$builds" 2>/dev/null)"
  for sha in $shas; do
    # A cached answer counts only if it was collected for the needle in force
    # now. Change the setting and every commit is looked at again, which is
    # the honest reading of "flag files matching this".
    entry="$(jq -c --arg s "$sha" --arg n "$needle" \
      '.[$s] // empty | select(.needle == $n) | .paths' <<<"$cache" 2>/dev/null)"
    if [ -z "$entry" ]; then
      entry="$(commit_flagged_paths "$repo" "$sha" "$needle")" || entry=""
      [ -n "$entry" ] || entry="[]"
    fi
    fresh="$(jq -c --arg s "$sha" --arg n "$needle" --argjson p "$entry" \
      '.[$s] = {needle: $n, paths: $p}' <<<"$fresh" 2>/dev/null)" || fresh="$fresh"
  done

  # Written back holding only the commits still on screen, so the file stays
  # the size of the window rather than growing for the life of the project.
  if [ -n "${cache_path:-}" ]; then
    printf '%s\n' "$fresh" | write_private "$cache_path"
  fi

  jq -c --argjson f "$fresh" 'map(. + {flagged: (($f[.sha].paths) // [])})' <<<"$builds" 2>/dev/null \
    || printf '%s' "$builds"
}

# The jobs of one workflow run, with the step each one is on. Only ever asked
# for a run that is still going: a finished build is a duration and a colour,
# and a running one is the only case where "what is it doing right now" is a
# question anybody has.
run_jobs() {
  gh_get "repos/$1/actions/runs/$2/jobs?per_page=50" || return 1
  printf '%s' "$GH_OUT" | jq -c '
    def jstate:
      if (.status as $s | ["queued","in_progress","waiting","requested","pending"] | index($s)) then "running"
      elif .conclusion == null then "running"
      elif .conclusion == "success" then "success"
      elif .conclusion == "skipped" or .conclusion == "neutral" then "skipped"
      elif .conclusion == "cancelled" then "cancelled"
      else "failure"
      end;

    [ .jobs[]?
      | { name: (.name // ""),
          state: jstate,
          stepCount: ([ .steps[]? ] | length),
          stepsDone: ([ .steps[]? | select(.status == "completed") ] | length),
          # The step in progress, or the last one that finished when the job
          # is between steps: an empty line here reads as "stuck", and it is
          # usually only a runner picking up the next one.
          currentStep: (([ .steps[]? | select(.status == "in_progress") | .name ] | (.[0] // ""))
                        as $now
                        | if $now != "" then $now
                          else ([ .steps[]? | select(.status == "completed") | .name ] | (.[-1] // ""))
                          end) }
    ]
    | sort_by(if .state == "running" then 0 elif .state == "failure" then 1 else 2 end)
  ' 2>/dev/null
}

add_running_jobs() {
  local repo="$1" builds="$2"
  local ids id jobs merged="$builds"

  ids="$(jq -r ".[] | select(.state == \"running\") | .runs[] | select(.state == \"running\") | .id" \
          <<<"$builds" 2>/dev/null)"
  for id in $ids; do
    # An id out of the API on its way into a URL, so it is checked for shape
    # rather than trusted: this one really is only ever digits.
    [[ "$id" =~ ^[0-9]{1,20}$ ]] || continue
    jobs="$(run_jobs "$repo" "$id")" || continue
    [ -n "$jobs" ] || continue
    merged="$(jq -c --argjson id "$id" --argjson j "$jobs" \
      "map(.runs |= map(if .id == \$id then . + {jobs: \$j} else . end))" <<<"$merged" 2>/dev/null)" \
      || merged="$merged"
  done

  printf '%s' "$merged"
}

# ---------------------------------------------------------------- fetching

# gh writes its own diagnostics to stderr and can still exit 0, so the stream
# is kept rather than thrown at /dev/null: an empty answer and a failed call
# look identical on stdout, and only stderr tells them apart.
#
# Answers land in GH_OUT and GH_ERR rather than on stdout, because a command
# substitution runs in a subshell and a variable set in there does not come
# back out. Both halves are wanted: the reason a call failed is the difference
# between "GitHub is down" and "you are not logged in", and the widget can
# only say which if the reason survives the call.
GH_OUT=""
GH_ERR=""
gh_get() {
  local path="$1" errfile status
  errfile="$(mktemp "${TMPDIR:-/tmp}/omarchy-github-build-monitor-err.XXXXXX")" || return 1
  GH_OUT="$(gh api -- "$path" 2>"$errfile")"
  status=$?
  GH_ERR="$(cat -- "$errfile")"
  rm -f -- "$errfile"
  return $status
}

# Only ever emits one of these fixed strings. What GitHub said is matched
# against, never passed on: it is text from the network on its way to a panel.
fail_reason() {
  case "$GH_ERR" in
    *"gh auth login"*|*"Bad credentials"*|*"HTTP 401"*)
      printf 'gh is not logged in. Run: gh auth login' ;;
    *"HTTP 404"*|*"Not Found"*)
      printf 'no such project, or gh cannot see it' ;;
    *"rate limit"*|*"HTTP 403"*)
      printf 'GitHub refused the request: rate limit or no access' ;;
    *"could not resolve host"*|*"dial tcp"*|*"no such host"*)
      printf 'no connection to GitHub' ;;
    *)
      printf 'could not reach GitHub' ;;
  esac
}

# The jq program below is the whole model. It never touches the shell.
runs_to_builds() {
  jq -c --argjson limit "$1" '
    def rstate:
      if (.status as $s | ["queued","in_progress","waiting","requested","pending"] | index($s)) then "running"
      elif .conclusion == null then "running"
      elif .conclusion == "success" then "success"
      elif .conclusion == "skipped" or .conclusion == "neutral" then "skipped"
      elif .conclusion == "cancelled" then "cancelled"
      else "failure"
      end;

    # A build is as unfinished as its least finished part, and as broken as
    # its most broken one. Cancelled sits below failed because GitHub cancels
    # a run when a newer push supersedes it, which is not a broken build.
    def rollup:
      if any(.[]; . == "running") then "running"
      elif any(.[]; . == "failure") then "failure"
      elif any(.[]; . == "cancelled") then "cancelled"
      elif length > 0 and all(.[]; . == "skipped") then "skipped"
      else "success"
      end;

    def secs: if . < 0 then 0 else (. | floor) end;

    (now | floor) as $now
    | [ .workflow_runs[]?
        | { sha: (.head_sha // ""),
            id: (.id // 0),
            name: (.name // .workflow_name // ""),
            state: rstate,
            started: ((.run_started_at // .created_at // "1970-01-01T00:00:00Z") | fromdateiso8601),
            finished: ((.updated_at // .created_at // "1970-01-01T00:00:00Z") | fromdateiso8601),
            url: (.html_url // ""),
            actor: (.actor.login // ""),
            message: (.head_commit.message // "") } ]
    | map(select(.sha != ""))
    | group_by(.sha)
    | map({
        sha: .[0].sha,
        # A merge commit says "Merge pull request #1977 from owner/branch" on
        # its first line and what the change actually was on the line under the
        # blank one, so both are kept: the subject, and the first real line of
        # the body when there is one worth showing.
        message: (([ .[] | select(.message != "") | .message ] | (.[0] // "")) | split("\n")[0]),
        detail: (([ .[] | select(.message != "") | .message ] | (.[0] // ""))
                 | split("\n") | .[1:]
                 | map(select(test("^[[:space:]]*$") | not))
                 | (.[0] // "")),
        actor: ([ .[] | select(.actor != "") | .actor ] | (.[0] // "")),
        state: ([ .[] | .state ] | rollup),
        startedAt: ([ .[] | .started ] | min | floor),
        finishedAt: ([ .[] | .finished ] | max | floor),
        runs: ([ .[] | { id, name, state, url,
                         durationSec: ((if .state == "running" then $now else .finished end) - .started | secs) } ]
               | sort_by(.name))
      })
    | map(. + { durationSec: ((if .state == "running" then $now else .finishedAt end) - .startedAt | secs) })
    | sort_by(.startedAt) | reverse
    | .[0:$limit]
  '
}

# The branches of one project, so the settings screen can offer a list
# instead of asking somebody to spell one. Sorted with the default branch
# first: that is the one this widget is for, and the one almost everybody
# picks.
cmd_branches() {
  local repo="${1:-}" default=""

  [ -n "$repo" ] || die "no repository configured"
  repo="$(normalize_repo "$repo")"
  valid_repo "$repo" || die "not a GitHub project: paste the URL, or owner/name"
  command -v gh >/dev/null 2>&1 || die "the gh CLI is not installed"

  gh_get "repos/$repo" || die "$(fail_reason)"
  default="$(printf '%s' "$GH_OUT" | jq -r '.default_branch // empty')"

  gh_get "repos/$repo/branches?per_page=100" || die "$(fail_reason)"
  printf '%s' "$GH_OUT" | jq -c --arg repo "$repo" --arg default "$default" '
    {ok: true, repo: $repo, default: $default,
     branches: ([ .[]?.name // empty ]
                | sort
                | (map(select(. == $default)) + map(select(. != $default))))}
  ' 2>/dev/null || die "could not read the branches of $repo"
}

cmd_status() {
  local repo="${1:-}" branch="${2:-}" limit="${3:-$DEFAULT_LIMIT}" needle="${4:-}"
  local runs builds

  [ -n "$repo" ] || die "no repository configured"
  repo="$(normalize_repo "$repo")"
  valid_repo "$repo" || die "not a GitHub project: paste the URL, or owner/name"
  # Said plainly rather than as a failed API call, because "could not reach
  # owner/name" sends you looking at the network when the answer is one
  # install away.
  command -v gh >/dev/null 2>&1 || die "the gh CLI is not installed"
  valid_limit "$limit" || limit="$DEFAULT_LIMIT"

  if [ -n "$branch" ]; then
    valid_branch "$branch" || die "not a branch name"
  else
    # Inline rather than behind a helper on purpose: a helper would be called
    # inside $( ), and the reason the call failed is set on a variable that a
    # subshell keeps to itself.
    gh_get "repos/$repo" || die "$(fail_reason)"
    branch="$(printf '%s' "$GH_OUT" | jq -r '.default_branch // empty')"
    [ -n "$branch" ] || die "could not find the default branch of $repo"
  fi

  # event=push only. A scheduled job and a comment-triggered workflow both
  # attach to the head of the branch, and counting those as builds of that
  # commit turns a green main red because a nightly cron failed.
  gh_get "repos/$repo/actions/runs?branch=$branch&event=push&per_page=60&exclude_pull_requests=true" \
    || die "$(fail_reason)"
  runs="$GH_OUT"

  builds="$(printf '%s' "$runs" | runs_to_builds "$limit" 2>/dev/null)"
  [ -n "$builds" ] || die "could not read the runs of $repo"

  # Lowercased here so the comparison further down is a plain substring test
  # on two strings that are already in the same case.
  needle="$(printf '%s' "$needle" | tr '[:upper:]' '[:lower:]')"
  builds="$(add_flagged_paths "$repo" "$needle" "$builds")"
  builds="$(add_running_jobs "$repo" "$builds")"
  builds="$(add_avatars "$builds")"

  jq -cn --arg repo "$repo" --arg branch "$branch" --argjson builds "$builds" \
    '{ok: true, repo: $repo, branch: $branch, fetchedAt: (now|floor), builds: $builds}'
}

# ------------------------------------------------------------------- demo

demo_builds() {
  # The invented project, whatever it was asked about. Echoing the real
  # repository back is how a demo ends up with somebody's actual project name
  # in the panel header of a screenshot.
  local repo="acme/checkout" branch="main"
  jq -cn --arg repo "$repo" --arg branch "$branch" '
    (now | floor) as $now
    | { ok: true, demo: true, repo: $repo, branch: $branch, fetchedAt: $now,
        builds: [
          { sha: "9f31c0ad4c2e6b1a", message: "Merge pull request #482 from acme/split-checkout-totals", detail: "Split the checkout totals into their own component",
            actor: "renee-dev", state: "running", startedAt: ($now - 214), finishedAt: $now,
            durationSec: 214, flagged: [],
            runs: [ {name: "Lint", state: "success", durationSec: 63, url: "", id: 1},
                    {name: "Tests & Deploy", state: "running", durationSec: 214, url: "", id: 2,
                     jobs: [ {name: "test", state: "running", stepCount: 14, stepsDone: 9,
                              currentStep: "Run the system tests"},
                             {name: "build", state: "success", stepCount: 11, stepsDone: 11,
                              currentStep: "Complete job"},
                             {name: "deploy", state: "running", stepCount: 13, stepsDone: 2,
                              currentStep: "Push the image"} ] } ] },
          { sha: "1c77e2b9a0d4f331", message: "Cache the tax table for the duration of a request", detail: "",
            actor: "renee-dev", state: "success", startedAt: ($now - 3120), finishedAt: ($now - 2489),
            durationSec: 631, flagged: ["db/migrate/20260214093012_add_tax_region_to_orders.rb"],
            runs: [ {name: "Lint", state: "success", durationSec: 58, url: ""},
                    {name: "Tests & Deploy", state: "success", durationSec: 631, url: ""} ] },
          { sha: "42a9d6f0e8b17c55", message: "Merge pull request #479 from acme/refund-webhooks", detail: "Handle refund webhooks out of order",
            actor: "tobias", state: "failure", startedAt: ($now - 9800), finishedAt: ($now - 9412),
            durationSec: 388, flagged: [],
            runs: [ {name: "Lint", state: "success", durationSec: 61, url: ""},
                    {name: "Tests & Deploy", state: "failure", durationSec: 388, url: ""} ] },
          { sha: "77b0154ce93a2d68", message: "Drop the unused shipping_zone_id column", detail: "",
            actor: "renee-dev", state: "cancelled", startedAt: ($now - 14200), finishedAt: ($now - 13990),
            durationSec: 210, flagged: ["db/migrate/20260213144501_drop_shipping_zone_id.rb"],
            runs: [ {name: "Tests & Deploy", state: "cancelled", durationSec: 210, url: ""} ] },
          { sha: "0ae5b3319d7f4c02", message: "Merge pull request #476 from acme/idempotent-charges", detail: "Make charge creation idempotent per order",
            actor: "tobias", state: "success", startedAt: ($now - 21600), finishedAt: ($now - 20940),
            durationSec: 660, flagged: [],
            runs: [ {name: "Lint", state: "success", durationSec: 55, url: ""},
                    {name: "Tests & Deploy", state: "success", durationSec: 660, url: ""} ] }
        ] }'
}

# ---------------------------------------------------------------- dispatch

case "${1:-status}" in
  status)
    shift
    if demo_on; then demo_builds "${1:-}" "${2:-}"; else cmd_status "${1:-}" "${2:-}" "${3:-}" "${4:-}"; fi
    ;;
  branches)
    shift
    if demo_on; then
      printf '{"ok":true,"demo":true,"repo":"acme/checkout","default":"main","branches":["main","release-2026-02","staging"]}\n'
    else
      cmd_branches "${1:-}"
    fi
    ;;
  demo)
    private_dir "$CACHE_DIR" || die "could not create a private cache directory"
    case "${2:-}" in
      on)  printf 'on\n' | write_private "$DEMO_FILE" && printf '{"ok":true,"demo":true}\n' ;;
      off) rm -f -- "$DEMO_FILE"; printf '{"ok":true,"demo":false}\n' ;;
      *)   if demo_on; then printf '{"ok":true,"demo":true}\n'; else printf '{"ok":true,"demo":false}\n'; fi ;;
    esac
    ;;
  *)
    die "unknown command"
    ;;
esac
